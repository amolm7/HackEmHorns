# Meta Model API (dev.meta.ai). Do not use a Graph API access token.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Optional alternative provider:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=8000

# Sign-in (literal mode name; never put a password here):
AUTH_MODE=development
# Provision a user with scripts/create_user.py, then use AUTH_MODE=password.
WORKER_CONCURRENCY=2
MODEL_MAX_RETRIES=3
# Production requires password auth and HTTPS behind a reverse proxy:
# APP_ENV=production
# APP_ORIGIN=https://agents.example.com
# DATABASE_PATH=/app/data/workforce.sqlite3
