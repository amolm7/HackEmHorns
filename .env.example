# Meta Model API (dev.meta.ai). Do not use a Graph API access token.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Optional alternative provider:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: minimal, low, medium or high. Lower is faster; leave blank for the model default.
GEMINI_THINKING=
PORT=8000
# GitHub reading (optional). The admin's token is used for everyone. Add locally, restart, then Library > Prepare GitHub.
# Fine-grained token: selected repositories, Contents read and Issues read.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Sign-in (literal mode name; never put a password here):
AUTH_MODE=development
# Provision a user with scripts/create_user.py, then use AUTH_MODE=password.
WORKER_CONCURRENCY=2
MODEL_MAX_RETRIES=3
MODEL_TIMEOUT=60
# Production requires password auth and HTTPS behind a reverse proxy:
# APP_ENV=production
# APP_ORIGIN=https://agents.example.com
# DATABASE_PATH=/app/data/workforce.sqlite3

# Hosted demo (Render): see docs/DEPLOY.md. These are set in the host's dashboard, not in a file.
# ADMIN_USERNAME=demo-admin          # created on first boot if missing
# ADMIN_PASSWORD=                    # 12 or more characters
# GITHUB_DEMO_REPO=owner/repo        # the one repository the shared GitHub token may read
# ALLOW_SIGNUP=1                     # shows "Create an account" on the sign-in screen
# SIGNUP_CODE=                       # optional invite code testers must enter
# SIGNUPS_PER_HOUR=10                # per client address
# SIGNUP_LIMIT=300                   # total self-service accounts
