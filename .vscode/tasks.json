{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install backend dependencies",
      "type": "shell",
      "command": "\"${workspaceFolder}/.venv/bin/python\" -m pip install -r requirements-dev.txt",
      "problemMatcher": []
    },
    {
      "label": "Run backend",
      "type": "shell",
      "command": "\"${workspaceFolder}/.venv/bin/python\" server.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Test backend",
      "type": "shell",
      "command": "\"${workspaceFolder}/.venv/bin/python\" -m unittest discover -s tests -v",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run HTTP demo",
      "type": "shell",
      "command": "\"${workspaceFolder}/.venv/bin/python\" scripts/demo.py",
      "problemMatcher": []
    }
  ]
}
